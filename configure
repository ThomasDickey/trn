  "Pnews" ) CONFIG_FILES="$CONFIG_FILES Pnews" ;;
  "Pnews.header" ) CONFIG_FILES="$CONFIG_FILES Pnews.header:Pnews_header.in" ;;
  "Rnmail" ) CONFIG_FILES="$CONFIG_FILES Rnmail" ;;
  "Speller" ) CONFIG_FILES="$CONFIG_FILES Speller" ;;
  "access.def" ) CONFIG_FILES="$CONFIG_FILES access.def:access_def.in" ;;
  "norm.saver" ) CONFIG_FILES="$CONFIG_FILES norm.saver:norm_saver.in" ;;
  "mbox.saver" ) CONFIG_FILES="$CONFIG_FILES mbox.saver:mbox_saver.in" ;;
  "makedir" ) CONFIG_FILES="$CONFIG_FILES makedir" ;;
  "filexp" ) CONFIG_FILES="$CONFIG_FILES filexp" ;;
  "Policy.sh" ) CONFIG_FILES="$CONFIG_FILES Policy.sh:Policy_sh.in" ;;
  "myinstall" ) CONFIG_FILES="$CONFIG_FILES myinstall" ;;
  "makedepend" ) CONFIG_FILES="$CONFIG_FILES makedepend" ;;
  "newsnews" ) CONFIG_FILES="$CONFIG_FILES newsnews" ;;
