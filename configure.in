TRN_NUMBER(ROOTID, 0)
TRN_SYMBOL(SCAN,/**/)
TRN_SYMBOL(SCORE,/**/)
TRN_NUMBER(SELECT_INIT, TRUE)
TRN_STRING(SERVER_NAME, [/etc/news/server])
