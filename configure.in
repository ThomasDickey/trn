TRN_POLICY(d_berknames, 'define')
TRN_POLICY(d_usgnames, 'undef')
TRN_POLICY(d_acttimes, 'define')
TRN_POLICY(PORTABLE, 'undef')
TRN_POLICY(d_useov, '')

TRN_POLICY(cf_by, $USER)
TRN_POLICY(cf_time, `date`)

dnl optionally comment-out chunks of makefile:

MAKE_INEWS=""
AC_SUBST(MAKE_INEWS)

MAKE_MSDOS="#"
AC_SUBST(MAKE_MSDOS)

MAKE_NDIR="#"
AC_SUBST(MAKE_NDIR)

MAKE_NNTP=""
AC_SUBST(MAKE_NNTP)

MAKE_STRFTIME="#"
AC_SUBST(MAKE_STRFTIME)

TK_INCS=
AC_SUBST(TK_INCS)

TK_LIBS=
AC_SUBST(TK_LIBS)

TK_LDFLAGS=
AC_SUBST(TK_LDFLAGS)

NNTP_FLAGS=
AC_SUBST(NNTP_FLAGS)

INEWS_BIN=$PRIVBIN
AC_SUBST(INEWS_BIN)

NDIR_LIB=
AC_SUBST(NDIR_LIB)

JOBS_LIB=
AC_SUBST(JOBS_LIB)

TERM_LIB=
AC_SUBST(TERM_LIB)

FILEXP_PATH=$PRIVLIB/filexp
AC_SUBST(FILEXP_PATH)

LDFLAGS="-Wl,-z,relro"
AC_SUBST(LDFLAGS)

LINKFLAGS=
AC_SUBST(LINKFLAGS)

MANDIR=/usr/share/man/man1
AC_SUBST(MANDIR)

MANSECT=1
AC_SUBST(MANSECT)

NAMETYPE=bsd
AC_SUBST(NAMETYPE)

PAGER=/usr/bin/pager
AC_SUBST(PAGER)

PGPCOMMAND=pgp
AC_SUBST(PGPCOMMAND)

RNMAILER=/usr/sbin/sendmail
AC_SUBST(RNMAILER)

EXTRA_CLEANUP=
AC_SUBST(EXTRA_CLEANUP)

AC_CONFIG_FILES([Makefile Rnmail Speller access.def:access_def.in norm.saver:norm_saver.in mbox.saver:mbox_saver.in makedir filexp Policy.sh:Policy_sh.in myinstall ],[
if ! grep "WARNING" Makefile > /dev/null
then
	grep -F -v ".SH" dependencies >> Makefile
fi
])
AC_OUTPUT
