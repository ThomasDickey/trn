dnl
AC_PREREQ(2.52.20210509)
AC_INIT
AC_CONFIG_SRCDIR([trn.c])
AC_CONFIG_HEADER(config.h)
CF_CHECK_CACHE

###	checks for alternative programs

CF_PROG_CC
AC_C_INLINE
AC_PROG_CPP
CF_PROG_INSTALL
AC_ARG_PROGRAM
CF_PROG_LINT
CF_PROG_YACC

###	checks for compiler characteristics
CF_XOPEN_SOURCE(700)
CF_SIGWINCH

###	checks for header files
AC_CHECK_DECL(exit)
AC_CHECK_HEADERS( \
sys/ptem.h \
termcap.h \
termios.h \
)

###	checks for typedefs
AC_CHECK_TYPE(time_t, long)

###	checks for library functions
AC_CHECK_FUNCS( \
	ftime \
	getcwd \
	getdomainname \
	gethostname \
	getpwent \
	gettimeofday \
	getwd \
	memcmp \
	memcpy \
	memset \
	mkdir \
	rename \
	sigblock \
	sighold \
	strcasecmp \
	strchr \
	strstr )
CF_FUNC_GETTIME
CF_FUNC_STRFTIME
CF_SETITIMER

CF_HELP_MESSAGE(Compile/Install Options:)
CF_FUNC_TGETENT

AC_SUBST(SINSTALL_OPTS)

###	checks for external data
CF_ERRNO

###	checks for system services and user specified options

AC_PATH_XTRA
CF_POSIX_WAIT
CF_SYSV
CF_SVR4

###############################################################################
CF_HELP_MESSAGE(Optional Features:)

###############################################################################
CF_HELP_MESSAGE(Testing/development Options:)

CF_DISABLE_LEAKS
CF_DISABLE_ECHO
CF_ENABLE_WARNINGS
CF_MAKE_TAGS

###############################################################################
CF_HELP_MESSAGE(Hard-coded/incomplete Options:)

define([TRN_POLICY],[
	$1=$2
	AC_SUBST($1)
])

define([TRN_SYMBOL],[
	AC_DEFINE($1, $2)
])

define([TRN_NUMBER],[
	AC_DEFINE($1, $2)
	$1=$2
	AC_SUBST($1)
])

define([TRN_STRING],[
	AC_DEFINE($1, "$2")
	$1=\""$2"\"
	AC_SUBST($1)
])

dnl strings that are used in other definitions
TRN_STRING(PRIVBIN, [/usr/lib/trn4])
TRN_STRING(PRIVLIB, [/usr/share/trn4])

TRN_STRING(ispell_prg, [/usr/bin/ispell])
