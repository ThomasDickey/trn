TRN_NUMBER(SUPPORT_NNTP,1)
TRN_NUMBER(SUPPORT_XTHREAD,1)
TRN_NUMBER(Signal_t, void)
TRN_STRING(THREAD_DIR,[remote])
TRN_NUMBER(THREAD_INIT, FALSE)
TRN_NUMBER(USE_GENAUTH,1)

dnl random define/undef symbols
